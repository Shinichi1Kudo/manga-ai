server:
  port: 8081
  servlet:
    context-path: /api

spring:
  application:
    name: manga-ai

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://YOUR_HOST:3306/manga_ai?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&connectTimeout=10000&socketTimeout=60000&autoReconnect=true
    username: YOUR_USERNAME
    password: YOUR_PASSWORD
    hikari:
      minimum-idle: 2
      maximum-pool-size: 10
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000

  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 100MB

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai
    default-property-inclusion: non_null

mybatis-plus:
  mapper-locations: classpath:mapper/**/*.xml
  type-aliases-package: com.manga.ai.*.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: isDeleted
      logic-delete-value: 1
      logic-not-delete-value: 0
    banner: false

# 火山方舟 API 配置
volcengine:
  ark:
    api-key: YOUR_API_KEY
    model: doubao-seedream-5-0-260128
    lite-model: doubao-seedream-5-0-lite-260128
    base-url: https://ark.cn-beijing.volces.com/api/v3
    timeout: 120000
  seedance:
    api-key: YOUR_API_KEY
    base-url: https://ark.cn-beijing.volces.com/api/v3
    fast-api-key: ${VOLCENGINE_SEEDANCE_FAST_API_KEY:YOUR_FAST_API_KEY}
    fast-base-url: https://toapis.com/v1
    model: seedance-2.0
    subject-replacement-model: doubao-seedance-2-0-260128
    timeout: 600000
    poll-interval: 5000

gpt-image2:
  api-key: ${TOAPIS_API_KEY:${GPT_IMAGE2_API_KEY:YOUR_API_KEY}}
  base-url: https://toapis.com/v1
  model: gpt-image-2
  timeout: 300000
  poll-interval: 3000
  stale-timeout: 1800000

commerce:
  model-profile:
    api-key: ${TOAPIS_API_KEY:${gpt-image2.api-key:YOUR_API_KEY}}
    base-url: https://toapis.com/v1
    model: deepseek-v4-pro
  model-image:
    api-key: ${volcengine.ark.api-key}
    base-url: https://ark.cn-beijing.volces.com/api/v3
    model: doubao-seedream-5-0-260128
  try-on-first-frame:
    model: doubao-seedream-5-0-lite-260128

tencent:
  sms:
    secret-id: ${TENCENT_SMS_SECRET_ID:}
    secret-key: ${TENCENT_SMS_SECRET_KEY:}
    sdk-app-id: ${TENCENT_SMS_SDK_APP_ID:1400632889}
    sign-name: ${TENCENT_SMS_SIGN_NAME:北京乙帧科技有限公司}
    login-template-id: ${TENCENT_SMS_LOGIN_TEMPLATE_ID:2645843}
    reset-template-id: ${TENCENT_SMS_RESET_TEMPLATE_ID:2647581}
    region: ${TENCENT_SMS_REGION:ap-guangzhou}
    code-expire-minutes: ${TENCENT_SMS_CODE_EXPIRE_MINUTES:10}

alipay:
  server-url: ${ALIPAY_SERVER_URL:https://openapi-sandbox.dl.alipaydev.com/gateway.do}
  app-id: ${ALIPAY_APP_ID:}
  app-private-key: ${ALIPAY_APP_PRIVATE_KEY:}
  alipay-public-key: ${ALIPAY_PUBLIC_KEY:}
  seller-id: ${ALIPAY_SELLER_ID:}
  notify-url: ${ALIPAY_NOTIFY_URL:https://www.yzmovie.com/api/v1/payments/alipay/notify}
  charset: UTF-8
  sign-type: RSA2
  timeout-express: 2h

# 文件存储配置
storage:
  base-path: ./storage
  temp-path: ./storage/temp
  project-path: ./storage/projects

# NLP 配置
nlp:
  confidence-threshold: 0.6

# 异步任务配置
task:
  executor:
    core-pool-size: 5
    max-pool-size: 10
    queue-capacity: 100
    thread-name-prefix: manga-ai-

# 视频生成专用线程池和限流配置
video:
  executor:
    core-pool-size: 100
    max-pool-size: 100
    queue-capacity: 1000
  generation:
    user-concurrency-limit: 15
    limiter-task-ttl: 3600000

logging:
  level:
    com.manga.ai: debug
    org.springframework.web: info
